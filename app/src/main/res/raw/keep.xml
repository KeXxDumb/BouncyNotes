<?xml version="1.0" encoding="utf-8"?>
<!--
    isShrinkResources está en false (ver app/build.gradle.kts) después de
    confirmar que el shrinker borraba PNGs de íconos del APK final sin que
    esta lista lograra protegerlos de forma confiable. Esta lista queda
    igual como red de seguridad documentada, actualizada a los nombres
    actuales (sistema de íconos planos, sin adaptive-icon) por si en algún
    momento se reactiva el shrinker.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_icon_peach,@drawable/ic_icon_notegirl,@drawable/ic_icon_melons,@drawable/ic_notification" />
