<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:theme="@style/Theme.Notes">

    <ListView
        android:id="@+id/ListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- Visible cuando el widget todavía no tiene ninguna nota asignada
         (recién agregado, antes de terminar la configuración) o cuando la
         nota asignada ya no existe. Tocarlo reabre el selector de notas. -->
    <TextView
        android:id="@+id/Empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/pinned_note_widget_select_note"
        android:textColor="?android:attr/textColorSecondary" />

</FrameLayout>
