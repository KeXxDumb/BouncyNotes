<?xml version="1.0" encoding="utf-8"?>
<!--
    ListView + RemoteViewsFactory (AllNotesClockWidgetService/Factory), NO
    un LinearLayout armado a mano: ListView SÍ está soportado dentro de un
    RemoteViews de widget de pantalla de inicio (a diferencia de ScrollView,
    que NO lo está — eso seguía siendo cierto, no era el diagnóstico
    equivocado). Lo que sí estaba mal era la conclusión de que "cada fila
    abre una nota distinta" obligaba a resignar el scroll: un ListView
    respaldado por RemoteViewsFactory SÍ puede diferenciar cada fila,
    combinando una plantilla de PendingIntent con el fill-in Intent propio
    de cada fila (mecanismo oficial de Android) — ver el comentario largo en
    AllNotesClockWidgetProvider.openNoteTemplatePendingIntent() y en
    AllNotesClockWidgetFactory.getViewAt() para el detalle completo de por
    qué esta combinación puntual (plantilla de ACTIVITY, no de broadcast) no
    repite el bug de MIUI que sí tenía el viejo ACTION_OPEN_NOTE.

    FrameLayout + ListView/Empty superpuestos: mismo patrón que
    widget_pinned_note.xml, para que setEmptyView() pueda alternar entre
    los dos automáticamente.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_light"
    android:orientation="vertical">

    <!-- TextClock: vista nativa, se actualiza sola cada minuto — mismo
         truco que ya usa QuickActionsWidgetProvider, no hace falta
         programar ningún refresco propio para esto. Más chico que el de
         Acciones rápidas porque acá comparte espacio con la lista. -->
    <TextClock
        android:id="@+id/Clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:format12Hour="h:mm a"
        android:format24Hour="H:mm"
        android:textSize="20sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Visible cuando todavía no hay ninguna nota (sin contar papelera
             y privadas, igual que el resto de los widgets). -->
        <TextView
            android:id="@+id/Empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/all_notes_clock_widget_empty"
            android:textColor="?android:attr/textColorSecondary" />

    </FrameLayout>

</LinearLayout>
