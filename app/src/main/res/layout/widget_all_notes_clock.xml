<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget de reloj + notas, según el boceto del usuario: TRES tarjetas
    redondeadas más oscuras (lista de notas, reloj, próximo recordatorio)
    dentro del rectángulo redondeado más claro que es el fondo del widget
    (widget_background_*, sin cambios). Las tarjetas se separan entre sí
    con el hueco de 8dp del fondo, no con líneas — las únicas líneas que
    quedan son las que separan una nota de otra DENTRO de la tarjeta de la
    lista.

    Cada tarjeta lleva su fondo (widget_tile_*) puesto en tiempo de
    ejecución por el provider (setBackgroundResource), porque depende del
    tema claro/oscuro elegido para ESTE widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_light"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Tarjeta izquierda: la lista scrolleable de siempre (mismo Factory,
         mismo click template, mismo layout de fila). -->
    <FrameLayout
        android:id="@+id/NotesTile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4">

        <ListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <!-- Visible cuando todavía no hay ninguna nota (sin contar papelera
             y privadas, igual que el resto de los widgets). -->
        <TextView
            android:id="@+id/Empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/all_notes_clock_widget_empty"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>

    <!-- Columna derecha: dos tarjetas apiladas, con 8dp entre sí y 8dp
         respecto de la lista. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TextClock: vista nativa, se actualiza sola cada minuto. El
             propio TextClock ES la tarjeta (lleva el fondo directo). -->
        <TextClock
            android:id="@+id/Clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:format12Hour="h:mm a"
            android:format24Hour="H:mm"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Próximo recordatorio entre TODAS las notas — ver
             ReminderScheduler.nextTrigger, usado en
             AllNotesClockWidgetProvider. Tocable: abre la nota dueña; sin
             click si no hay ningún recordatorio próximo. -->
        <LinearLayout
            android:id="@+id/ReminderBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/ReminderLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_notes_clock_widget_reminder_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ReminderValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
