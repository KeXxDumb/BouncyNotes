<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_light"
    android:orientation="vertical">

    <!-- TextClock: vista nativa, se actualiza sola cada minuto. La
         apariencia se configura con long press > Configurar (ver
         widgetFeatures="reconfigurable" en el widget-info) — sin ícono
         propio en el widget, redundante con eso. -->
    <TextClock
        android:id="@+id/Clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:format12Hour="h:mm a"
        android:format24Hour="H:mm"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Divisor entre el reloj y la lista de notas — mismo criterio que
         HeaderDivider en widget_pinned_note.xml (LinearLayout vacío, NO
         View: RemoteViews para widgets de pantalla de inicio no tiene a
         android.view.View en su lista de vistas permitidas — rompía TODO
         el widget al agregarlo). -->
    <LinearLayout
        android:id="@+id/HeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp" />

    <!--
        ListView + RemoteViewsFactory de nuevo (se había sacado por el bug
        de clicks rotos en Xiaomi/MIUI, ver el historial en
        AllNotesClockWidgetProvider.kt) — ScrollView no está permitido en
        RemoteViews para widgets de pantalla de inicio, así que sin
        ListView no hay forma de scrollear de verdad. El bug de clicks se
        resolvió de otra forma (plantilla de Activity DIRECTA con datos por
        extra, ver el comentario grande en el provider), así que se puede
        volver a tener las dos cosas: scroll real Y clicks confiables.
    -->
    <ListView
        android:id="@+id/ListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- Visible cuando todavía no hay ninguna nota (sin contar papelera y
         privadas, igual que el resto de los widgets). -->
    <TextView
        android:id="@+id/Empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/all_notes_clock_widget_empty"
        android:textColor="?android:attr/textColorSecondary" />

</LinearLayout>
