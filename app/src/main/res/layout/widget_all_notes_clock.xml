<?xml version="1.0" encoding="utf-8"?>
<!--
    REDISEÑADO (a partir de un boceto del usuario): antes era reloj arriba +
    lista scrolleable abajo, todo apilado verticalmente. Ahora es un split
    horizontal — lista de notas a la izquierda (más ancha, es lo que más
    espacio necesita para leerse), reloj + próximo recordatorio apilados a
    la derecha. Mismo fondo/estilo de siempre (un solo widget_background_*,
    sin paneles ni tarjetas nuevas) — el boceto separaba visualmente las
    secciones con líneas finas, no con fondos propios, así que se resolvió
    con divisores (mismo criterio que HeaderDivider de antes: un
    LinearLayout vacío de 1dp, coloreado en tiempo de ejecución, NO una
    View — ver ese comentario viejo sobre por qué).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_light"
    android:orientation="horizontal">

    <!-- Columna izquierda: la lista scrolleable de siempre (mismo Factory,
         mismo click template, mismo layout de fila) — solo cambió DÓNDE
         vive dentro del widget, no cómo funciona. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4">

        <ListView
            android:id="@+id/ListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <!-- Visible cuando todavía no hay ninguna nota (sin contar papelera
             y privadas, igual que el resto de los widgets). -->
        <TextView
            android:id="@+id/Empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/all_notes_clock_widget_empty"
            android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>

    <!-- Divisor VERTICAL entre las dos columnas. -->
    <LinearLayout
        android:id="@+id/VerticalDivider"
        android:layout_width="1dp"
        android:layout_height="match_parent" />

    <!-- Columna derecha: reloj arriba, recordatorio próximo abajo. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TextClock: vista nativa, se actualiza sola cada minuto. Más
             grande que antes (20sp -> 30sp) para llenar bien esta mitad
             superior, como en el boceto. La apariencia (tema/fondo) se
             configura con long press > Configurar. -->
        <TextClock
            android:id="@+id/Clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:format12Hour="h:mm a"
            android:format24Hour="H:mm"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/HeaderDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <!-- Próximo recordatorio entre TODAS las notas (no de una nota en
             particular) — ver ReminderScheduler.nextTrigger, reusado tal
             cual en AllNotesClockWidgetProvider. Tocable: abre la nota
             dueña de ese recordatorio, directo (mismo
             openNotePendingIntent que ya usan los otros widgets). Sin
             click si no hay ningún recordatorio próximo (Empty=true) —
             no tiene sentido "abrir" nada en ese caso. -->
        <LinearLayout
            android:id="@+id/ReminderBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/ReminderLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/all_notes_clock_widget_reminder_label"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/ReminderValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorPrimary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
