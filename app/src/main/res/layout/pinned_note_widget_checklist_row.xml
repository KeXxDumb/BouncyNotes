<?xml version="1.0" encoding="utf-8"?>
<!--
    Envuelto en un LinearLayout vertical (antes la fila era directo el
    horizontal de abajo) para poder meter un divisor ARRIBA de la fila —
    mismo criterio visual que el checklist real de la nota (ChecklistEditor,
    en la app). RowDivider se oculta para el primer ítem (ver
    getNoteWidgetChecklistRowView: no tiene sentido un divisor arriba del
    primer ítem, no hay nada de qué separarlo).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/RowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:id="@+id/ChecklistRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/CheckboxGlyph"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ChecklistText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
