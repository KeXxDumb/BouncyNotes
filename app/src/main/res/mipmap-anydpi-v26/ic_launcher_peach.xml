<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono adaptativo "peach" (Android 8+). El arte (ic_icon_peach.webp, que es
     un cuadrado a sangre completa) va dentro de un <inset 16%> sobre un
     fondo del mismo color, para que quepa en la zona segura de 72dp del
     lienzo de 108dp y el launcher lo vea como adaptativo: sin esto, MIUI,
     Samsung One UI y otros lo tratan como ícono "viejo" y lo achican dentro
     de un cuadrado blanco. No lleva capa <monochrome>: no hay silueta
     real del arte y una improvisada se vería mal con íconos temáticos.
     En Android 7 y anteriores se usa mipmap-nodpi/ic_launcher_peach.webp. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_peach" />
    <foreground>
        <inset
            android:drawable="@drawable/ic_icon_peach"
            android:inset="16%" />
    </foreground>
</adaptive-icon>
