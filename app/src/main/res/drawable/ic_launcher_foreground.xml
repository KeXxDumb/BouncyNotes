<?xml version="1.0" encoding="utf-8"?>
<!-- Rediseño v2: una hoja de papel (con la esquina doblada, típico ícono de
     "nota") con un rayón/garabato simulando texto, y por debajo de la hoja
     asoma un durazno (la mascota real de la app). El durazno se dibuja
     PRIMERO (queda atrás) y el papel se dibuja DESPUÉS (encima), tapando la
     mitad de arriba del durazno — solo se le ve la panza inferior asomando
     por debajo del borde de la hoja. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Durazno, atrás. Cuerpo simple (sin lóbulos/tallo/hoja: esa parte
         queda tapada por el papel de todos modos) + una sombra sutil para
         dar volumen a lo que sí se ve. -->
    <path
        android:fillColor="#FF8A65"
        android:pathData="M29,76 a25,22 0 1,0 50,0 a25,22 0 1,0 -50,0 z" />
    <path
        android:fillColor="#E8735A"
        android:pathData="M54,80 a12,14 0 1,0 24,0 a12,14 0 1,0 -24,0 z" />

    <!-- Hoja de papel, adelante, con la esquina superior derecha doblada
         ("dog-ear"), el detalle clásico de ícono de nota. -->
    <path
        android:fillColor="#FFF3E0"
        android:pathData="M26,22 L74,22 L82,30 L82,74 L26,74 Z" />
    <path
        android:fillColor="#FFE0B2"
        android:pathData="M74,22 L82,30 L74,30 Z" />

    <!-- El rayón simulando texto: una sola línea garabateada, no un bloque
         de texto prolijo. -->
    <path
        android:strokeColor="#8D6E63"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M34,48 C40,40 46,54 52,46 C58,38 64,52 70,44" />
</vector>
