<?xml version="1.0" encoding="utf-8"?>
<!-- Rediseño: antes esto dibujaba unas líneas de nota abstractas, sin
     ninguna relación con la mascota real de la app (el 🍑 que rebota en
     NoteListScreen.kt / BouncyPeach()). Ahora es un durazno vectorial de
     verdad, para que el ícono de la app coincida con esa identidad visual.
     Estructura: dos lóbulos superpuestos (los "cachetes" del durazno) +
     una panza redondeada abajo que los une, una sombra sutil a la derecha
     para dar volumen, una línea del "gajo" central, tallo y hoja arriba. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Guía de zona segura (108dp totales, contenido dentro de ~66dp
         centrales) — invisible, solo referencia de tamaño, igual que en la
         versión anterior. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0"
        android:pathData="M30,24h48a6,6 0,0 1,6 6v48a6,6 0,0 1,-6 6h-48a6,6 0,0 1,-6 -6v-48a6,6 0,0 1,6 -6z" />

    <!-- Cuerpo principal: lóbulo izquierdo + lóbulo derecho + panza,
         todos del mismo color (el "union" visual sale solo por ser
         subtrazados superpuestos del mismo relleno). -->
    <path
        android:fillColor="#FF8A65"
        android:pathData="M22,54 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 z
                           M46,54 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 z
                           M20,66 a34,26 0 1,0 68,0 a34,26 0 1,0 -68,0 z" />

    <!-- Sombra en el lóbulo derecho, para dar volumen (como en el emoji
         real, que tiene un lado más oscuro). -->
    <path
        android:fillColor="#E8735A"
        android:pathData="M56,60 a14,18 0 1,0 28,0 a14,18 0 1,0 -28,0 z" />

    <!-- Línea del "gajo" central, el detalle que más lo identifica como
         durazno y no como una manzana o un círculo cualquiera. -->
    <path
        android:strokeColor="#E8735A"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,42 C50,55 58,70 54,82" />

    <!-- Tallo. -->
    <path
        android:fillColor="#5D4037"
        android:pathData="M57,34 L60,34 L61,22 L58,22 Z" />

    <!-- Hoja. -->
    <path
        android:fillColor="#7CB342"
        android:pathData="M52,30 C56,22 68,22 72,28 C68,34 56,34 52,30 Z" />
</vector>
