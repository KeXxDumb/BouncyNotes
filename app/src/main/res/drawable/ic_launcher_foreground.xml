        android:fillColor="#FFF3E0"
        android:pathData="M24,20 L76,20 L84,28 L84,88 L24,88 Z" />
    <path
        android:fillColor="#FFE0B2"
        android:pathData="M76,20 L84,28 L76,28 Z" />

