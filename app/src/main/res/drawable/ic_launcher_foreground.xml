        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M30,40 C36,32 42,46 48,38 C54,30 60,44 66,36" />

    <!-- Marco de la "imagen adjunta", dentro de la hoja, debajo del texto. -->
