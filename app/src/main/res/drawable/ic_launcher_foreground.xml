<?xml version="1.0" encoding="utf-8"?>
<!-- "Durazno": nota de papel completa (con esquina doblada) que contiene,
     DENTRO de sus límites: un rayón garabateado arriba (el "texto") y,
     debajo de esa línea, un durazno chico dentro de un marco tipo foto
     adjunta — simulando una nota real de la app con texto + imagen
     complementaria. Nada del dibujo sale de la hoja. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

