<?xml version="1.0" encoding="utf-8"?>
<!-- Rediseño v2: mismo lenguaje visual que ic_launcher_foreground.xml (nota
     de papel con esquina doblada + rayón), pero con 2 melones (🍈)
     levemente superpuestos asomando debajo, en vez de un durazno — para
     mantener el ícono reconocible como "otro ícono de nota", distinto al
     por defecto, y seguir comparando vector contra Note Girl (PNG). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Melón de atrás: más chico, un poco más oscuro y corrido hacia la
         izquierda — la superposición con el de adelante es lo que da la
         sensación de profundidad. -->
    <path
        android:fillColor="#AED581"
        android:pathData="M44,78 m-20,0 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0 z" />

    <!-- Melón de adelante: más grande, más claro, corrido hacia la
         derecha, dibujado después para que tape parte del de atrás. -->
    <path
        android:fillColor="#C5E1A5"
        android:pathData="M64,80 m-22,0 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 z" />

    <!-- Brillo sutil en el melón de adelante. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.4"
        android:pathData="M58,72 m-6,-4 a6,4 0 1,0 12,0 a6,4 0 1,0 -12,0 z" />

    <!-- Hoja de papel, igual que en el ícono por defecto. -->
    <path
        android:fillColor="#FFF3E0"
        android:pathData="M26,22 L74,22 L82,30 L82,74 L26,74 Z" />
    <path
        android:fillColor="#FFE0B2"
        android:pathData="M74,22 L82,30 L74,30 Z" />

    <!-- Rayón simulando texto, igual que en el ícono por defecto. -->
    <path
        android:strokeColor="#8D6E63"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M34,48 C40,40 46,54 52,46 C58,38 64,52 70,44" />
</vector>
