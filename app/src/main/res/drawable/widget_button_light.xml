<?xml version="1.0" encoding="utf-8"?>
<!-- Botones más "notorios" (pedido original): antes solo tenían el ripple
     de selectableItemBackground, sin ningún límite visible en reposo. Este
     fondo (una píldora semitransparente) les da un contorno visible
     siempre, no solo al tocar.

     BUG (reportado): con 20% de opacidad (#33) se veía "demasiado opaco,
     raro" tanto en claro como oscuro — bajado a 10%, bastante más sutil,
     solo lo justo para que se note el límite del botón. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="16dp" />
    <solid android:color="#1A000000" />
</shape>
