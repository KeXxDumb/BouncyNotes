<?xml version="1.0" encoding="utf-8"?>
<!--
    Sin android:configure: a diferencia del widget de "nota fijada", este
    no necesita elegir nada al agregarlo — siempre muestra la nota con
    updatedAt más reciente, sin importar cuál sea.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_pinned_note"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/last_edited_note_widget_description" />
