<?xml version="1.0" encoding="utf-8"?>
<!--
    Rediseño a dos columnas (lista a la izquierda, reloj+recordatorio a la
    derecha) — necesita más ANCHO que el diseño apilado de antes para no
    verse apretado, así que minWidth subió de 180dp a 250dp. targetCellWidth
    se deja igual (4): en la mayoría de los launchers ya da más de 250dp de
    ancho real, así que este mínimo es sobre todo para cuando alguien
    redimensiona el widget más chico a mano. Sin poder probarlo en un
    dispositivo real, es un punto de partida razonable — capaz haga falta
    ajustarlo con el resultado real a la vista.

    configure/widgetFeatures: ver el comentario en
    last_edited_note_widget_info.xml (misma config activity compartida).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_all_notes_clock"
    android:previewLayout="@layout/widget_all_notes_clock"
    android:configure="com.dumb.bouncynotes.widget.WidgetAppearanceConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/all_notes_clock_widget_description" />
