<?xml version="1.0" encoding="utf-8"?>
<!--
    minWidth/minHeight de 2x2 celdas aprox (110dp): un tamaño chico como
    para convivir con otros widgets/íconos, pero que alcanza para título +
    unas líneas de preview. resizeMode permite agrandarlo si el usuario
    quiere ver más texto.

    initialLayout usa el layout de "cargando" que ya trae la propia librería
    Glance (glance_default_loading_layout): se ve un instante, antes de que
    termine la primera composición async del widget real.

    updatePeriodMillis="0": no hay refresco periódico automático del
    sistema. El refresco lo dispara la propia app (NoteRepository, después
    de cada save/delete) llamando a PinnedNoteWidget().updateAll().
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="com.dumb.bouncynotes.widget.PinnedNoteWidgetConfigActivity"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/pinned_note_widget_description" />
