<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Para los recordatorios de notas: notificaciones, alarmas exactas y
         volver a programarlas tras reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Para poder pedirle al usuario que excluya la app del ahorro de
         batería: sin esto, en fabricantes como Samsung o Xiaomi (MIUI) el
         sistema puede seguir matando/demorando la alarma del recordatorio
         aunque se use setAlarmClock(). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Solo hace falta en Android 9 o anterior para poder guardar imágenes o
         videos de una nota en la carpeta pública Pictures/Movies del
         teléfono (desde Android 10 en adelante MediaStore no la necesita). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".BouncyNotesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!-- Sin intent-filter propio: el lanzamiento se hace a través de los
             activity-alias de abajo, que son los que definen el ícono visible.
             Así se puede cambiar el ícono en tiempo de ejecución habilitando un
             alias y deshabilitando el otro, sin tocar MainActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Notes" />

        <!-- Ícono por defecto. Habilitado al principio. -->
        <activity-alias
            android:name=".DefaultIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ícono alternativo "Note Girl". Deshabilitado al principio; se activa
             desde Ajustes. -->
        <activity-alias
            android:name=".NoteGirlIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notegirl"
            android:roundIcon="@mipmap/ic_launcher_notegirl"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ícono morado de prueba (100% PNG, ver el comentario en
             mipmap-anydpi-v26/ic_launcher_purple_note.xml): para aislar si el
             refresco de ícono en MIUI depende de que el ícono use un PNG.
             Deshabilitado al principio; se activa desde Ajustes. -->
        <activity-alias
            android:name=".PurpleNoteIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple_note"
            android:roundIcon="@mipmap/ic_launcher_purple_note"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".data.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.BootReminderReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Instalar una versión nueva de la app también le borra a
                     AlarmManager las alarmas ya programadas, igual que un
                     reinicio del teléfono. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
