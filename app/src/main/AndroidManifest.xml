<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Para los recordatorios de notas: notificaciones, alarmas exactas y
         volver a programarlas tras reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Para poder pedirle al usuario que excluya la app del ahorro de
         batería: sin esto, en fabricantes como Samsung o Xiaomi (MIUI) el
         sistema puede seguir matando/demorando la alarma del recordatorio
         aunque se use setAlarmClock(). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Solo hace falta en Android 9 o anterior para poder guardar imágenes o
         videos de una nota en la carpeta pública Pictures/Movies del
         teléfono (desde Android 10 en adelante MediaStore no la necesita). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".BouncyNotesApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_icon_peach"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_icon_peach"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!-- Sin intent-filter propio: el lanzamiento se hace a través de los
             activity-alias de abajo, que son los que definen el ícono visible.
             Así se puede cambiar el ícono en tiempo de ejecución habilitando un
             alias y deshabilitando el otro, sin tocar MainActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Notes" />

        <!-- "Durazno": nota con texto + durazno adjunto dentro de la hoja
             (ver ic_icon_peach.png, ícono plano sin adaptive-icon).
             Habilitado al principio. -->
        <activity-alias
            android:name=".PeachIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_icon_peach"
            android:roundIcon="@drawable/ic_icon_peach"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ícono alternativo "Note Girl" (PNG). Deshabilitado al principio;
             se activa desde Ajustes. -->
        <activity-alias
            android:name=".NoteGirlIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_icon_notegirl"
            android:roundIcon="@drawable/ic_icon_notegirl"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Melones": misma estructura que Durazno, con 2 melones
             superpuestos dentro de la hoja en vez de un durazno. 100%
             vectorial. Deshabilitado al principio; se activa desde Ajustes. -->
        <activity-alias
            android:name=".MelonsIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_icon_melons"
            android:roundIcon="@drawable/ic_icon_melons"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".data.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.BootReminderReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Instalar una versión nueva de la app también le borra a
                     AlarmManager las alarmas ya programadas, igual que un
                     reinicio del teléfono. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Widget de "nota fijada" (solo lectura), sobre RemoteViews/
             AppWidgetProvider clásico — no Glance (ver historial: Glance
             tenía una carrera de timing entre la Activity de configuración
             y su primer render, que este enfoque, mucho más viejo y
             probado, no tiene). exported=false: el sistema invoca el
             provider a través de AppWidgetManager, no por un broadcast que
             cualquier app externa pudiera enviar. -->
        <receiver
            android:name=".widget.PinnedNoteWidgetProvider"
            android:exported="false"
            android:label="@string/pinned_note_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pinned_note_widget_info" />
        </receiver>

        <!-- Le da el contenido de la lista (ListView) del widget: un header
             más un renglón por cada bloque de texto/imagen de la nota, en
             su orden real. BIND_REMOTEVIEWS es obligatorio para cualquier
             RemoteViewsService: solo el sistema puede bindearse a este
             servicio, ninguna otra app. -->
        <service
            android:name=".widget.PinnedNoteWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Widget de "última nota editada" (automático, sin Activity de
             configuración): siempre muestra la nota con updatedAt más
             reciente. -->
        <receiver
            android:name=".widget.LastEditedNoteWidgetProvider"
            android:exported="false"
            android:label="@string/last_edited_note_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/last_edited_note_widget_info" />
        </receiver>

        <service
            android:name=".widget.LastEditedNoteWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Widget de acciones rápidas (nueva nota / nuevo checklist +
             reloj): sin lista ni RemoteViewsService, son botones fijos. -->
        <receiver
            android:name=".widget.QuickActionsWidgetProvider"
            android:exported="false"
            android:label="@string/quick_actions_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- Se abre al agregar el widget a la pantalla de inicio (para
             elegir qué nota le corresponde) y también al tocar el ícono de
             "cambiar nota" del encabezado, para reconfigurar sin tener que
             quitar y volver a agregar el widget. exported=false: las
             acciones APPWIDGET_CONFIGURE las dispara el sistema, no hace
             falta exponerla a otras apps. -->
        <activity
            android:name=".widget.PinnedNoteWidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.Notes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
