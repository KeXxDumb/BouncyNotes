<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Para los recordatorios de notas: notificaciones, alarmas exactas y
         volver a programarlas tras reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Para poder pedirle al usuario que excluya la app del ahorro de
         batería: sin esto, en fabricantes como Samsung o Xiaomi (MIUI) el
         sistema puede seguir matando/demorando la alarma del recordatorio
         aunque se use setAlarmClock(). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Solo hace falta en Android 9 o anterior para poder guardar imágenes o
         videos de una nota en la carpeta pública Pictures/Movies del
         teléfono (desde Android 10 en adelante MediaStore no la necesita). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".BouncyNotesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Notes"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <!-- Sin intent-filter propio: el lanzamiento se hace a través de los
             activity-alias de abajo, que son los que definen el ícono visible.
             Así se puede cambiar el ícono en tiempo de ejecución habilitando un
             alias y deshabilitando el otro, sin tocar MainActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Notes" />

        <!-- "Durazno": nota con texto + durazno adjunto dentro de la hoja
             (ver ic_peach_background.png / ic_peach_monochrome.png, ambos
             PNG). Habilitado al principio. -->
        <activity-alias
            android:name=".PeachIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Ícono alternativo "Note Girl" (PNG). Deshabilitado al principio;
             se activa desde Ajustes. -->
        <activity-alias
            android:name=".NoteGirlIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notegirl"
            android:roundIcon="@mipmap/ic_launcher_notegirl"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- "Melones": misma estructura que Durazno, con 2 melones
             superpuestos dentro de la hoja en vez de un durazno. 100%
             vectorial. Deshabilitado al principio; se activa desde Ajustes. -->
        <activity-alias
            android:name=".MelonsIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_melons"
            android:roundIcon="@mipmap/ic_launcher_melons"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- EXPERIMENTO TEMPORAL — 3 íconos PNG idénticos (misma imagen,
             solo cambia el matiz de color), cada uno con su propio
             monochrome. Objetivo: confirmar si el launcher del usuario
             refresca PNG en general una vez que tiene monochrome, o si
             el problema sigue siendo específico de PNG sin importar qué
             tan bien armado esté. Sacar estos 3 alias (y sus recursos
             ic_pngtest_*) una vez que se tenga la respuesta. -->
        <activity-alias
            android:name=".PngTestOriginalIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pngtest_original"
            android:roundIcon="@mipmap/ic_launcher_pngtest_original"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".PngTestTealIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pngtest_teal"
            android:roundIcon="@mipmap/ic_launcher_pngtest_teal"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".PngTestVioletIconAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pngtest_violet"
            android:roundIcon="@mipmap/ic_launcher_pngtest_violet"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".data.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.BootReminderReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Instalar una versión nueva de la app también le borra a
                     AlarmManager las alarmas ya programadas, igual que un
                     reinicio del teléfono. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
